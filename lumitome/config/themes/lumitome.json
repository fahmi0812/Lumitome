{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "cornsilk": "#FFF8DC",
    "ivory": "#FFF4C8",
    "glow": "#FFF6D5",
    "champagne": "#F3D27A",
    "gold": "#E8C266",
    "goldSoft": "#E6C77E",
    "goldRule": "#D4AF5A",
    "goldDeep": "#C9962E",
    "bronze": "#B8892A",
    "bronzeDeep": "#A97A1E",
    "umber": "#9C6F17",
    "ink": "#7A5A1A",
    "inkMuted": "#8C7346",
    "paper": "#FFFDF7",
    "paper2": "#F8EED8",
    "paper3": "#EEDDB6",
    "night": "#0E0C08",
    "night2": "#17140D",
    "night3": "#221D12",
    "nightBorder": "#3A3020",
    "nightMuted": "#A8957A",
    "red": "#E5735C",
    "redLight": "#B23A26",
    "green": "#B9C97A",
