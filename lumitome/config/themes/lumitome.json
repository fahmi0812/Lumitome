      "light": "inkMuted"
    },
    "syntaxKeyword": {
      "dark": "champagne",
      "light": "umber"
    },
    "syntaxFunction": {
      "dark": "gold",
      "light": "bronzeDeep"
    },
    "syntaxVariable": {
      "dark": "cornsilk",
      "light": "ink"
    },
    "syntaxString": {
      "dark": "green",
      "light": "greenLight"
    },
    "syntaxNumber": {
      "dark": "goldSoft",
      "light": "bronze"
    },
    "syntaxType": {
      "dark": "blue",
      "light": "blueLight"
    },
    "syntaxOperator": {
      "dark": "goldRule",
      "light": "umber"
    },
    "syntaxPunctuation": {
      "dark": "nightMuted",
      "light": "inkMuted"
