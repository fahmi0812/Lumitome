      "dark": "champagne",
      "light": "umber"
    },
    "secondary": {
      "dark": "goldSoft",
      "light": "bronze"
    },
    "accent": {
      "dark": "gold",
      "light": "bronzeDeep"
    },
    "error": {
      "dark": "red",
      "light": "redLight"
    },
    "warning": {
      "dark": "gold",
