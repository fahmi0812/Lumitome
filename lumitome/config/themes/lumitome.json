    "success": {
      "dark": "green",
      "light": "greenLight"
    },
    "info": {
      "dark": "blue",
      "light": "blueLight"
    },
    "text": {
      "dark": "cornsilk",
      "light": "ink"
    },
    "textMuted": {
      "dark": "goldDeep",
      "light": "inkMuted"
    },
    "background": {
      "dark": "night",
      "light": "paper"
    },
    "backgroundPanel": {
