// Lumitome — config dasar (dimuat sebagai OPENCODE_CONFIG_DIR oleh bin/lumitome).
// Override final yang tidak bisa dikalahkan config proyek dikirim wrapper via OPENCODE_CONFIG_CONTENT.
// "model" di bawah = DEFAULT_MODEL; sumber tunggal: lumitome/lib/default-model.mjs & default-config.mjs (v0.4.0 Wave 0).
{
  "$schema": "https://opencode.ai/config.json",
  "model": "9router/ag/gemini-3.8-flash-high",
  "default_agent": "orchestrator",
  "providers": {
    "9router": {
      "name": "9router",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": { "baseURL": "{env:LUMI_9ROUTER_URL}", "apiKey": "{env:LUMI_KEY_9ROUTER}" },
      // limit default model (fallback bila fragment provider belum ada limit):
      // 9router capabilities.js pola *gemini-3.8* → contextWindow 1048576, maxOutput 65536.
      // Nilai hidup per model diteruskan detectModels() (lumitome/lib/providers.mjs) dari
      // GET /v1/models 9router — JANGAN ubah angka ini tanpa cek capabilities 9router.
      // Tanpa limit.context, engine default context 0 → ceiling auto-compact = Infinity
      // dan auto-compact proaktif tidak terpicu sebelum overflow.
      "models": { "ag/gemini-3.8-flash-high": { "name": "gemini-3.8-flash-high (9router)", "limit": { "context": 1048576, "output": 65536 } } }
    }
  },
  "compaction": { "auto": true, "keep": { "tokens": 24000 }, "buffer": "10%" },
  "tool_output": { "max_lines": 400, "max_bytes": 16384 },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    // v0.3.71 scope B: external_directory ask → allow (seperti OpenCode biasa).
    { "action": "external_directory", "resource": "*", "effect": "allow" }
  ]
}
