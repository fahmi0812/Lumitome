{
  "$comment": "Pemetaan MCP per sektor (v0.1.6). Sumber untuk scripts/gen-policy.mjs → frontmatter permissions agent. Deny-by-default (*_*), lalu allow server sektor sendiri. Tanpa Kali, tanpa trading.",
  "servers": {
    "context7":   { "kind": "direct", "default": "enabled",  "risk": "R", "src": "https://github.com/upstash/context7" },
    "codemem":    { "kind": "direct", "default": "enabled",  "risk": "S", "src": "https://github.com/DeusData/codebase-memory-mcp", "pin": "v0.12.1", "ask": ["delete_project", "manage_adr"] },
    "playwright": { "kind": "direct", "default": "enabled",  "risk": "S", "src": "https://github.com/microsoft/playwright-mcp" },
    "chromedev":  { "kind": "direct", "default": "enabled",  "risk": "S", "src": "https://github.com/ChromeDevTools/chrome-devtools-mcp" },
    "markitdown": { "kind": "direct", "default": "enabled",  "risk": "R", "src": "https://github.com/microsoft/markitdown" },
    "figma":      { "kind": "direct", "default": "disabled", "risk": "S", "src": "https://developers.figma.com/docs/figma-mcp-server/", "needs": "OAuth (opencode mcp auth figma)" },
    "github":     { "kind": "direct", "default": "disabled", "risk": "T", "src": "https://github.com/github/github-mcp-server", "needs": "env GITHUB_PERSONAL_ACCESS_TOKEN", "ask": ["create_*", "update_*", "merge_*", "push_*", "delete_*", "fork_*", "add_*", "request_*", "assign_*", "dismiss_*", "run_*", "cancel_*", "rerun_*"] },
    "drawio":     { "kind": "direct", "default": "disabled", "risk": "S", "src": "https://github.com/DayuanJiang/next-ai-draw-io", "pin": "@next-ai-drawio/mcp-server@0.4.14", "needs": "opt-in LUMI_MCP=...,drawio (preview browser lokal)" },
    "figcraft":   { "kind": "direct", "default": "disabled", "risk": "S", "src": "https://github.com/storytold/figcraft", "pin": "v0.18.1", "needs": "figcraft-cli terpasang (AppImage: FigCraft.AppImage cli); opt-in LUMI_MCP=...,figcraft" },
    "stitch":     { "kind": "direct", "default": "disabled", "risk": "S", "src": "https://stitch.withgoogle.com/docs/mcp/setup/", "needs": "env STITCH_API_KEY (Stitch Settings > API Keys); opt-in LUMI_MCP=...,stitch", "ask": ["create_project", "delete_project", "generate_*", "edit_*", "apply_*", "create_design_system*", "update_design_system"] }
  },
  "sectors": {
    "coding":    ["context7", "codemem", "github", "playwright", "chromedev"],
    "media":     ["figma", "playwright", "chromedev", "figcraft", "stitch"],
    "riset":     ["context7", "markitdown", "playwright"],
    "penulisan": ["context7", "markitdown", "drawio"],
    "security":  ["context7", "codemem"],
    "finance":   ["markitdown"]
  },
  "agents": {
    "orchestrator": [],
    "synthesizer": [],
    "elephant": ["context7", "codemem"],
    "goldfish": ["codemem"]
  },
  "gateway": {
    "default": "disabled",
    "host": "127.0.0.1",
    "basePort": 8811,
    "order": ["coding", "media", "riset", "penulisan", "security", "finance"]
  },
  "banned": ["kali", "metasploit", "nmap", "sqlmap", "trading", "alpaca", "ccxt", "freqtrade", "binance"]
}
